{
  "name": "@r-diego24/my-components",
  "version": "0.1.1",
  "description": "A modern React UI component library with Tailwind CSS, featuring buttons, cards, icons, and layout components with neon effects.",
  "author": "R-Diego24",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/R-Diego24/my-components.git"
  },
  "homepage": "https://github.com/R-Diego24/my-components#readme",
  "bugs": {
    "url": "https://github.com/R-Diego24/my-components/issues"
  },
  "keywords": [
    "react",
    "components",
    "ui",
    "tailwindcss",
    "typescript",
    "storybook",
    "design-system",
    "button",
    "card",
    "icon"
  ],
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "style": "dist/styles.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/styles.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "scripts": {
    "storybook": "storybook dev -p 6006",
    "build": "pnpm build:lib && pnpm build-storybook",
    "build-storybook": "storybook build",
    "build:css": "tailwindcss -i ./src/index.css -o ./dist/styles.css --minify",
    "build:lib": "tsup && pnpm build:css",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:storybook": "vitest run --project storybook",
    "prepublishOnly": "pnpm test && pnpm build:lib"
  },
  "packageManager": "pnpm@10.19.0",
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.1.0",
    "@fortawesome/free-solid-svg-icons": "^7.1.0",
    "@fortawesome/react-fontawesome": "^3.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^4.1.3",
    "@storybook/addon-a11y": "^10.0.8",
    "@storybook/addon-docs": "^10.0.8",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-vitest": "^10.0.8",
    "@storybook/react-vite": "^10.0.8",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.9.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitest/browser-playwright": "4.0.3",
    "@vitest/coverage-v8": "4.0.3",
    "autoprefixer": "^10.4.22",
    "cpx": "^1.5.0",
    "eslint": "^9.38.0",
    "eslint-plugin-storybook": "^10.0.8",
    "jsdom": "^27.0.1",
    "playwright": "^1.56.1",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sass": "^1.93.2",
    "storybook": "^10.0.8",
    "tailwindcss": "^3.4.17",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "^4.0.3"
  },
  "eslintConfig": {
    "extends": [
      "plugin:storybook/recommended"
    ]
  }
}
